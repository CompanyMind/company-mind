# Marketing site env. Copy to .env.local for local dev, or set in the host's dashboard.
# The marketing site is stateless — this is the ONLY variable it needs.

# Where design-partner enquiries from /api/waitlist are POSTed as JSON.
# Without it, /api/waitlist returns 503 in production ON PURPOSE (fails closed
# rather than dropping a lead to stdout). Point it at any JSON POST endpoint:
# a Zapier/Make catch hook, a Slack incoming webhook, a CRM intake, your server.
WAITLIST_WEBHOOK_URL=
