# Copy to .env for docker-compose. NEVER commit .env.
# --- Postgres ---
POSTGRES_USER=compbrain
POSTGRES_PASSWORD=
POSTGRES_DB=compbrain
# DATABASE_URL is consumed by web (Drizzle) and engine. Host is the compose service name.
DATABASE_URL=postgres://compbrain:@db:5432/compbrain
# --- Auth (web) ---
# 32+ random bytes, base64. Signs/derives session material. Rotating it logs everyone out.
SESSION_SECRET=
# --- web <-> engine trust ---
# Shared secret on every web->engine call. Engine rejects calls without it.
ENGINE_INTERNAL_SECRET=
ENGINE_BASE_URL=http://engine:8000
# --- engine -> models ---
# DEFAULT is OpenAI's hosted API. Set OPENAI_API_KEY and the defaults below work.
# WARNING: on the OpenAI default, prompts + source text are sent to OpenAI — that
# breaks the on-prem/sovereignty guarantee. For a real regulated deployment,
# point MODELS_BASE_URL at your OWN self-hosted OpenAI-compatible endpoint so
# nothing leaves your infrastructure (the API key is then optional).
MODELS_BASE_URL=https://api.openai.com/v1
OPENAI_API_KEY=
# Deterministic placeholder providers, for TESTS AND OFFLINE DEV ONLY. Leave
# unset. With neither a real provider nor this flag, the engine refuses to
# answer or ingest rather than serving fabricated text — the placeholder answer
# reads exactly like a real cited one, so a deployment missing a key used to
# look like a working one.
# FAKE_MODELS=1
LLM_MODEL=gpt-5.4-nano-2026-03-17
EMBED_MODEL=text-embedding-3-small
# Embedding dimension. MUST match the pinned value in web/lib/db/schema.ts
# (EMBED_DIM). For OpenAI text-embedding-3-* it is sent as the `dimensions`
# param; changing it means re-embedding every chunk.
EMBED_DIM=1024

# --- Retrieval (optional; sensible defaults live in engine/app/settings.py) ---
# Self-hosted cross-encoder reranker (e.g. bge-reranker). Empty → an LLM reranker
# when a model is configured, else a no-op that keeps fusion order.
RERANK_BASE_URL=
RERANK_MODEL=
# Chunk enrichment before embedding: off | header | llm
CONTEXTUAL_MODE=header
# --- storage (web) ---
# Where uploaded original files are written. In compose the web service
# overrides this to the mounted volume path (/data/uploads).
STORAGE_DIR=.storage

# Fernet key for encrypting Telegram bot tokens at rest (engine + bot).
# Generate: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
TELEGRAM_ENC_KEY=

# Public URL of the web app, for tappable source links in Telegram replies.
APP_URL=

# --- Marketing site: design-partner enquiries -------------------------------
# The contact form fails CLOSED with none of these set: it answers 503 and shows
# its mailto fallback, rather than thanking someone whose enquiry it dropped.
#
# Email delivery (recommended — the reply happens in email anyway). Get a key at
# resend.com; signing up with the address below lets you send to it immediately
# with no DNS setup.
RESEND_API_KEY=
LEAD_EMAIL_TO=
# Only once companymind.uz is verified in Resend. Leave blank until then — the
# code defaults to a sender that works without domain verification.
LEAD_EMAIL_FROM=
# Alternative to email: any endpoint accepting a JSON POST (Zapier/Make, a CRM).
# Ignored when RESEND_API_KEY + LEAD_EMAIL_TO are both set.
WAITLIST_WEBHOOK_URL=
